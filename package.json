{
    "name": "skattchat",
    "version": "1.0.0",
    "author": "SkyJin",
    "description": "An Electron chat app with both web and desktop versions.",
    "main": "electron/main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder",
        "web-start": "npm run start",
        "web-build": "npm run build"
    },
    "dependencies": {
        "axios": "^1.7.8",
        "socket.io-client": "^4.8.1"
    },
    "devDependencies": {
        "@babel/core": "^7.26.0",
        "@babel/preset-env": "^7.26.0",
        "babel-loader": "^9.2.1",
        "buffer": "^6.0.3",
        "dotenv": "^10.0.0",
        "electron": "^33.2.1",
        "electron-builder": "^25.1.8",
        "path-browserify": "^1.0.1",
        "source-map-loader": "^5.0.0",
        "webpack": "^5.96.1",
        "webpack-cli": "^5.1.4",
        "ws": "^8.18.0"
    },
    "build": {
        "appId": "com.example.skychat",
        "directories": {
            "output": "dist"
        },
        "files": [
            "electron/**",
            "public/**",
            "backend/**",
            "node_modules/**"
        ],
        "win": {
            "target": "nsis",
            "icon": "public/icons/icon.ico"
        },
        "mac": {
            "target": "dmg",
            "icon": "public/icons/icon.icns"
        },
        "linux": {
            "target": "AppImage",
            "icon": "public/icons/icon.png"
        },
        "publish": [
            {
                "provider": "generic",
                "url": "https://yourwebsite.com/downloads/"
            }
        ]
    }
}
