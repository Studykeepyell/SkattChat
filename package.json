{
    "name": "skattchat",
    "version": "1.0.0",
    "author": "SkyJin",
    "description": "An Electron chat app with both web and desktop versions.",
    "main": "electron/dist/main.bundle.cjs",
    "scripts": {
        "build:web": "webpack --config webpack/webpack.web.config.js",
        "build:electron": "webpack --config webpack/webpack.electron.config.js",
        "start": "electron ./electron/dist/main.bundle.cjs",
        "start:electron": "npm run build:electron && electron ./electron/dist/main.bundle.js",
        "start:web": "npm run build:web && serve ./public/dist",
        "dev:web": "webpack --config webpack/webpack.web.config.js --watch",
        "dev:electron": "webpack --config webpack/webpack.electron.config.js --watch",
        "build": "webpack --config webpack/webpack.electron.config.js",
        "package": "electron-builder -c electron-builder.config.js",
        "dist": "npm run build && npm run package",
        "test": "jest --config jest.config.js",
        "test:watch": "jest --config jest.config.js --watch",
        "test:e2e": "playwright test --config playwright.config.js",
        "test:unit": "jest --config jest.config.js",
        "start:test": "cross-env NODE_ENV=test electron ."
    },
    "dependencies": {
        "axios": "^1.7.9",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "socket.io-client": "^4.7.4"
    },
    "devDependencies": {
        "@babel/core": "^7.26.0",
        "@babel/plugin-proposal-optional-chaining": "^7.21.0",
        "@babel/plugin-transform-modules-commonjs": "^7.26.3",
        "@babel/plugin-transform-runtime": "^7.25.9",
        "@babel/preset-env": "^7.26.0",
        "@babel/runtime": "^7.26.0",
        "@electron/rebuild": "^3.6.0",
        "@playwright/test": "^1.49.0",
        "babel-loader": "^9.2.1",
        "buffer": "^6.0.3",
        "clean-webpack-plugin": "^4.0.0",
        "concurrently": "^8.2.2",
        "copy-webpack-plugin": "^12.0.2",
        "cross-env": "^7.0.3",
        "css-loader": "^6.11.0",
        "del-cli": "^5.1.0",
        "dotenv": "^10.0.0",
        "electron": "^33.2.1",
        "electron-builder": "^25.1.8",
        "electron-playwright-helpers": "^1.7.1",
        "electron-rebuild": "^3.2.9",
        "electron-reload": "^2.0.0-alpha.1",
        "express": "^4.21.2",
        "fs-extra": "^11.2.0",
        "html-loader": "^4.2.0",
        "html-webpack-plugin": "^5.6.3",
        "husky": "^8.0.3",
        "image-minimizer-webpack-plugin": "^3.8.3",
        "imagemin": "^8.0.1",
        "imagemin-gifsicle": "^5.2.0",
        "imagemin-mozjpeg": "^7.0.0",
        "imagemin-optipng": "^5.2.1",
        "imagemin-pngquant": "^5.0.1",
        "imagemin-svgo": "^10.0.1",
        "jest": "^29.7.0",
        "jest-environment-node": "^29.0.0",
        "node-gyp": "^9.4.1",
        "nodemon": "^3.1.7",
        "path": "^0.12.7",
        "path-browserify": "^1.0.1",
        "process": "^0.11.10",
        "rimraf": "^5.0.10",
        "source-map-loader": "^5.0.0",
        "spectron": "^10.0.1",
        "stream-browserify": "^3.0.0",
        "style-loader": "^3.3.4",
        "util": "^0.12.5",
        "webpack": "^5.97.1",
        "webpack-cli": "^5.1.4",
        "webpack-dev-middleware": "^7.4.2",
        "webpack-dev-server": "^5.1.0",
        "webpack-hot-middleware": "^2.26.1",
        "webpack-merge": "^5.10.0",
        "ws": "^8.18.0"
    },
    "build": {
        "appId": "com.skattchat.app",
        "files": [
            "dist/**/*"
        ],
        "directories": {
            "buildResources": "assets",
            "output": "release"
        },
        "extraResources": [
            "./assets/**"
        ],
        "npmRebuild": false,
        "nodeGypRebuild": false
    },
    "config": {
        "forge": {
            "rebuildConfig": {
                "force": true,
                "onlyModules": [
                    "utf-8-validate",
                    "bufferutil"
                ]
            }
        }
    }
}
