{
  "presets": [
    ["@babel/preset-env", {
      "targets": {
        "node": "current",
        "electron": "25"
      },
      "modules": false,
      "useBuiltIns": "usage",
      "corejs": 3
    }],
    "@babel/preset-typescript"
  ],
  "plugins": [
    "@babel/plugin-transform-runtime",
    "@babel/plugin-proposal-class-properties"
  ]
}