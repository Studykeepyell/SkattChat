{
  "name": "skattchat",
  "version": "1.0.0",
  "description": "An Electron chat app with both web and desktop versions.",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "start": "cross-env NODE_ENV=production electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "webpack --config webpack.electron.config.js --mode production",
    "watch": "webpack --config webpack.electron.config.js --watch --mode development",
    "dev:web": "webpack serve --config webpack.web.config.js --mode development",
    "dev:electron": "webpack --config webpack.electron.config.js --watch",
    "start:dev": "electron dist/electron/main.cjs --dev",
    "setup": "node scripts/setup-dirs.js",
    "prebuild": "rimraf dist/app dist/releases",
    "build:web": "webpack --config webpack.web.config.js --mode production",
    "build:electron": "webpack --config webpack.electron.config.js --mode production",
    "build:installer": "electron-builder build --config electron-builder.config.js",
    "build:all": "npm run prebuild && npm run build && npm run build:releases && rimraf ./temp",
    "build:releases": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false ELECTRON_BUILDER_CACHE=./temp electron-builder --config electron-builder.yml",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.config.js",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder -mwl",
    "clean:cache": "rimraf %LOCALAPPDATA%\\electron-builder\\cache && rimraf ./temp",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.5.4",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-runtime": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@jest/globals": "^29.7.0",
    "babel-loader": "^9.2.1",
    "buffer": "^6.0.3",
    "clean-webpack-plugin": "^4.0.0",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^7.0.3",
    "css-loader": "^6.11.0",
    "dotenv": "^16.4.7",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-reload": "^2.0.0-alpha.1",
    "html-loader": "^4.2.0",
    "image-minimizer-webpack-plugin": "^3.8.3",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "nodemon": "^3.1.7",
    "resolve.exports": "^2.0.2",
    "ts-jest": "^29.1.2",
    "url": "^0.11.4",
    "webpack-dev-server": "^5.1.0",
    "webpack-hot-middleware": "^2.26.1",
    "webpack-merge": "^5.10.0",
    "webpack-node-externals": "^3.0.0"
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ],
    "plugins": [
      "@babel/plugin-transform-runtime"
    ]
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.[t|j]sx?$": "babel-jest"
    },
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx"
    ],
    "extensionsToTreatAsEsm": [
      ".ts",
      ".js"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(resolve\\.exports)/)"
    ]
  },
  "author": "SkyJin",
  "license": "ISC"
}
