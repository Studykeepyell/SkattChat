{
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": true,
    "noImplicitAny": true,
    "module": "NodeNext",
    "target": "es2020",
    "jsx": "react",
    "allowJs": true,
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*", "public/scripts/*"]
    }
  },
  "include": [
    "public/scripts/**/*",
    "backend/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
} 